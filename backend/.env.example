# .env.example
DB_NAME=launchops_db
DB_USER=launchops_user
DB_PASSWORD=your_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# Used for Django's cache backend and as the Celery broker/result
# backend. Defaults to a local Redis instance if unset.
REDIS_URL=redis://127.0.0.1:6379/0

# Django core settings
# Generate a unique value with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-unique-secret-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Go live-quiz workers: use the same 32+ character secret in Django and Go.
# Keep it independent of SECRET_KEY. Compose supplies a local-only demo value.
LIVE_SERVICE_SECRET=replace-with-a-long-independent-secret-at-least-32-characters
LIVE_QUIZ_ENGINE=go
MONGO_URI=mongodb://localhost:27017
