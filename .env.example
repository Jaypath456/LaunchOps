# .env.example
#
# Consumed by docker-compose.yml to configure the mongo, backend,
# and frontend services. Copy to .env and adjust as needed:
#   cp .env.example .env
#
# Every variable already has a safe default baked into docker-compose.yml,
# so `docker compose up` works out of the box even without a .env file -
# this is only needed if you want to customize ports/credentials.

# --- MongoDB ---
MONGO_DB=launchops
MONGO_PORT=27017

# --- Django backend ---
SECRET_KEY=docker-compose-local-dev-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:13000
BACKEND_PORT=18000

# --- React frontend ---
REACT_APP_API_URL=http://localhost:18000/api
FRONTEND_PORT=13000
