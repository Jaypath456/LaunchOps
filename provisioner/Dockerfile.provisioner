FROM golang:1.27.3-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/provisioner ./cmd/provisioner
COPY internal/backoff ./internal/backoff
COPY internal/connectors ./internal/connectors
COPY internal/jobs ./internal/jobs
COPY internal/worker ./internal/worker
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /provisioner ./cmd/provisioner

FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /provisioner /provisioner
USER 65532:65532
EXPOSE 8081
ENTRYPOINT ["/provisioner"]
